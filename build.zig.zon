.{
    .name = .zig_routing,
    .version = "0.0.0",
    .fingerprint = 0xd668ffa270901cc6, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0-dev.1857",

    // Zero external dependencies: Zig std plus our own zig-utils libraries only.
    .dependencies = .{
        .zig_cli = .{
            .url = "git+https://github.com/zig-utils/zig-cli.git#d5b6d7cce234514e53073d566696cd2e69ef4836",
            .hash = "zig_cli-0.1.3-18T51LbtAwC1D5ymlw-xAeLSMooNBx2X2gDM4PawGb6c",
        },
        .zig_config = .{
            .url = "git+https://github.com/zig-utils/zig-config.git#6a59bfae390897ec4cdfd00bb7b3f7bf40247fb7",
            .hash = "zig_config-0.1.3-2XP110UdAQAID_n21NmBFyJfKDp4lPa_Bj91km9igos3",
        },
        .tls = .{
            .url = "git+https://github.com/zig-utils/zig-tls.git#58809e04c0d1d1e510fe8c14f47d709229f0adca",
            .hash = "zig_tls-0.1.1-CwcE5LFDKABKOOG5PgAOMEywgTuq_RqlKn93CEoN3pam",
        },
        .xml = .{
            .url = "git+https://github.com/zig-utils/zig-xml.git#93784e79d9590a2a5baf85886d22178391a511c9",
            .hash = "zig_xml-0.1.0-Lvy3xUFNAgB0VmljifHDq-urQn43yiEFdreOr5CIFdEK",
        },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "NOTICE",
        "README.md",
    },
}
