.{
    .name = .zig_routing,
    .version = "0.0.0",
    .fingerprint = 0xd668ffa270901cc6, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0-dev.1857",

    // Zero external dependencies: Zig std plus our own zig-utils libraries only.
    .dependencies = .{
        .zig_cli = .{
            .url = "git+https://github.com/zig-utils/zig-cli.git#9da0217f7309003023f59cfc0f189f8a7952c52e",
            .hash = "zig_cli-0.1.7-18T51F3HBACthLfY8ZikGG_1XmlqFWfag20LKSzLoQQM",
        },
        .zig_config = .{
            .url = "git+https://github.com/zig-utils/zig-config.git#b201301dc08b293c5ebd11235214f666dc29f519",
            .hash = "zig_config-0.1.3-2XP119a-AQB00UsmsdTDddJIvy5nitCuHWsXbfNyInz4",
        },
        .zig_benchmarks = .{
            .url = "git+https://github.com/zig-utils/zig-benchmarks.git#a2f15705e97d0611ce07da833c75e51e4a4f121f",
            .hash = "zig_bench-0.2.2-FoCM-3LkAwDmeHO3OUQLTmMKcKwLINmVD6FTf4Y8ZbIS",
        },
        .tls = .{
            .url = "git+https://github.com/zig-utils/zig-tls.git#b13b9316b1f9e2d5cd5e50b353df530fbed58e3f",
            .hash = "zig_tls-0.1.1-CwcE5G1cKAB3esEwd6YFF9qeu0GgH3UlH9XJRGg0HNwt",
        },
        .xml = .{
            .url = "git+https://github.com/zig-utils/zig-xml.git#93784e79d9590a2a5baf85886d22178391a511c9",
            .hash = "zig_xml-0.1.0-Lvy3xUFNAgB0VmljifHDq-urQn43yiEFdreOr5CIFdEK",
        },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "packages",
        "LICENSE",
        "NOTICE",
        "README.md",
    },
}
